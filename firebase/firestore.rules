rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security validation
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@admin\\.com$')
      );
    }

    // Design submissions
    match /designs/{designId} {
      // Anyone can read approved public designs
      allow read: if resource.data.status == 'approved' || isOwner(resource.data.creatorId) || isAdmin();

      // Authenticated users can create pending submissions
      allow create: if isSignedIn() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.creatorId == request.auth.uid;

      // Owners can update metadata; Admin can update approval status
      allow update: if (isOwner(resource.data.creatorId) && request.resource.data.status == resource.data.status) || isAdmin();

      // Only admins can delete submissions
      allow delete: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
    }
  }
}
